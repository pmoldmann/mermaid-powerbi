{
  "name": "mermaid-visual",
  "version": "1.3.2.0",
  "author": "Paul Moldmann",
  "scripts": {
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build.ps1",
    "package:notest": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build.ps1 -NoTest",
    "package:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build.ps1 -Dev",
    "package:raw": "webpack --config view-webpack.config",
    "package:dev:raw": "webpack --config view-webpack.dev.config",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "sass": "npx rebuild node-sass",
    "start": "webpack-dev-server --config view-webpack.dev.config.js",
    "audit": "npm audit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "eslint": "npx eslint . --ext .js,.jsx,.ts,.tsx",
    "lintfix": "eslint . --ext .js,.jsx,.ts,.tsx --fix"
  },
  "dependencies": {
    "@mermaid-js/layout-elk": "^0.2.1",
    "@reduxjs/toolkit": "2.12.0",
    "@uiw/react-md-editor": "^4.1.0",
    "d3-array": "3.2.4",
    "d3-axis": "3.0.0",
    "d3-format": "3.1.2",
    "d3-scale": "4.0.2",
    "d3-selection": "3.0.0",
    "d3-time-format": "4.1.0",
    "dompurify": "3.4.7",
    "handlebars": "^4.7.9",
    "katex": "0.16.45",
    "mdast-util-find-and-replace": "^3.0.2",
    "mermaid": "11.15.0",
    "powerbi-visuals-utils-dataviewutils": "6.1.0",
    "powerbi-visuals-utils-formattingutils": "^6.1.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-redux": "9.3.0",
    "refractor": "5.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-prism-plus": "2.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-definition-list": "2.0.0",
    "remark-math": "^6.0.0"
  },
  "overrides": {
    "uuid": ">=11.1.1",
    "file-loader": {
      "schema-utils": "^4.0.0"
    }
  },
  "resolutions": {
    "uuid": ">=11.1.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.2",
    "@babel/preset-react": "7.28.5",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/d3-array": "3.2.2",
    "@types/d3-axis": "3.0.6",
    "@types/d3-format": "3.0.4",
    "@types/d3-scale": "4.0.9",
    "@types/d3-selection": "3.0.11",
    "@types/d3-time-format": "4.0.3",
    "@types/dompurify": "3.2.0",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@types/react-inspector": "6.0.1",
    "@typescript-eslint/eslint-plugin": "8.60.0",
    "@typescript-eslint/parser": "8.60.0",
    "@vitest/coverage-v8": "^3.2.7",
