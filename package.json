{
  "name": "mermaid-visual",
  "version": "1.3.2.0",
  "author": "Paul Moldmann",
  "private": true,
  "scripts": {
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build.ps1",
    "package:notest": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build.ps1 -NoTest",
    "package:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build.ps1 -Dev",
    "package:raw": "webpack --config view-webpack.config",
    "package:dev:raw": "webpack --config view-webpack.dev.config",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "sass": "npx rebuild node-sass",
    "start": "webpack-dev-server --config view-webpack.dev.config.js",
    "audit": "npm audit",
    "lint": "eslint .",
    "eslint": "npx eslint .",
    "lintfix": "eslint . --fix"
  },
  "dependencies": {
    "@mermaid-js/layout-elk": "^0.2.3",
    "@reduxjs/toolkit": "2.12.0",
    "@uiw/react-md-editor": "^4.1.1",
    "dompurify": "3.4.14",
    "katex": "0.16.47",
    "mdast-util-find-and-replace": "^3.0.2",
    "mermaid": "11.17.0",
    "powerbi-visuals-utils-dataviewutils": "7.0.0",
    "powerbi-visuals-utils-formattingutils": "^7.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "9.3.0",
    "refractor": "5.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-prism-plus": "2.0.2",
    "rehype-rewrite": "~4.0.4",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-definition-list": "2.0.0",
    "remark-math": "^6.0.0"
  },
  "overrides": {
    "uuid": ">=11.1.1",
    "katex": "0.16.47",
    "file-loader": {
      "schema-utils": "^4.0.0"
    }
  },
  "resolutions": {
    "uuid": ">=11.1.1",
    "katex": "0.16.47",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.2",
    "@babel/preset-react": "7.28.5",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "babel-loader": "10.1.1",
    "babel-plugin-module-resolver": "5.0.3",
    "base64-inline-loader": "2.0.1",
    "css-loader": "7.1.4",
    "eslint": "10.8.1",
    "eslint-plugin-powerbi-visuals": "1.1.1",
    "file-loader": "6.2.0",
    "jsdom": "^29.1.1",
